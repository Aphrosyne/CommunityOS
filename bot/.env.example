# ==================================
# CommunityOS Bot 配置文件
# 复制此文件为 .env 并修改实际值
# ==================================

# NoneBot2 驱动（FastAPI，后续支持 Web 管理面板）
DRIVER=~fastapi

# 调试模式
DEBUG=false

# NoneBot2 框架日志（默认关闭，排查问题时开启）
DEBUG_NONEBOT=false

# OneBot 连接地址（NapCat WebSocket）
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

# OneBot 连接 Token（需与 NapCat 一致）
ONEBOT_ACCESS_TOKEN=communityos

# 权限配置
# 机器人所有者 QQ
OWNER=0
# Bot 管理员 QQ 列表（逗号分隔，如 123,456）
ADMINS=

# NoneBot2 框架超级用户（与 Bot Admin 无关）
SUPERUSERS=[]

# 机器人 QQ 号
BOT_QQ=0

# 日志级别
LOG_LEVEL=INFO

# 备份目录
BACKUP_DIR=../backups

# 被 @ 时的回复内容
GREETING_REPLY=你好呀 这里是柳千语

# 受管理的群（逗号分隔）
MANAGED_GROUPS=

# 在线解混淆网址
IMAGE_DECODE_URL=https://ranzt.com/xiaofanqiehunxiao

# 发布模式超时（秒）
PUBLISH_TIMEOUT=180

# 好友验证答案（完全匹配，空则不启用）
FRIEND_VERIFY_ANSWER=

# 自禁回复语句（竖线分隔，随机选取）
SELF_MUTE_REPLIES=戴好了|已老实|知道了

# 网址补全前缀
URL_AUTOCOMPLETE_PREFIX=https://www.nexusmods.com/skyrimspecialedition/mods/

# 图片缓存大小（MB）
IMAGE_CACHE_MAX_MB=500

# 图片大小限制
IMAGE_MAX_FILE_SIZE=20          # 单张文件大小上限（MB）
IMAGE_MAX_PIXELS=20000000       # 单张像素上限（2000 万）
IMAGE_WEBSITE_MAX_PIXELS=8000000 # 网站解图兼容上限（800 万）

# 单次发布图片上限
PUBLISH_MAX_IMAGES=10

# 回复节流窗口（秒）
REPLY_THROTTLE=5

# 发布冷却：cooldown = min(base + per_image * count, max)
PUBLISH_COOLDOWN_BASE=30
PUBLISH_COOLDOWN_PER_IMAGE=10
PUBLISH_COOLDOWN_MAX=90

# 超时扫描间隔（秒）
SESSION_SCAN_INTERVAL=10

# 指令冷却等级（秒）
COMMAND_COOLDOWN_L0=3    # 查询类：help, status
COMMAND_COOLDOWN_L1=5    # 会话启动类：publish, obfuscate, decode
COMMAND_COOLDOWN_L2=10   # 管理类（后续）

# 版本号
BOT_VERSION=1.0.1
